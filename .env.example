# Optional HTTP proxy, read at runtime. Only needed for sources that require it
# from your network (e.g. LinkedIn guest job API from mainland China).
# This file is an EXAMPLE — commit no real secrets. Copy to `.env` to use.
#
# Local (non-Docker) run — leave empty to connect directly:
#   HTTPS_PROXY=http://127.0.0.1:7890
HTTPS_PROXY=
HTTP_PROXY=
ALL_PROXY=

# Docker run — the proxy must be reachable FROM the container (e.g. host.docker.internal),
# NOT 127.0.0.1 (which points to the container itself). docker-compose reads this name:
#   LAB110_PROXY=http://host.docker.internal:7890
LAB110_PROXY=
